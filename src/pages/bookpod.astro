---
import HeroText from "~/components/widgets/HeroText.astro";
import Layout from "~/layouts/PageLayout.astro";

const metadata = {
	title: "Podcast Booking",
};
---

<Layout metadata={metadata}>
  <HeroText tagline="" title="Podcast Booking" />

  <section class="w-full">
    <div class="mx-auto max-w-4xl px-4 pb-12">
      <!-- Calendly inline widget begin -->
      <div class="calendly-inline-widget" data-url="https://calendly.com/pwcom/30min" style="min-width:320px;height:700px;"></div>
      <script is:inline type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
      <!-- Calendly inline widget end -->
    </div>
  </section>
</Layout>
